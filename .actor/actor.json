{
  "actorSpecification": 1,
  "name": "german-it-jobs-scraper",
  "title": "German IT Jobs Scraper with Contact Enrichment",
  "description": "Production-ready actor for scraping IT jobs from multiple German job portals (Google Jobs, StepStone, Indeed) with automatic contact enrichment for IT managers and HR decision-makers. Features PLZ filtering, recruitment agency detection, and Excel/CSV export.",
  "version": "2.0.0",
  "meta": {
    "templateId": "node-typescript"
  },
  "input": "./.actor/input_schema.json",
  "dockerfile": "./Dockerfile",
  "readme": "./README.md",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "IT Jobs Dataset",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "title",
              "company",
              "location",
              "workType",
              "salary",
              "jobUrl",
              "publishedDate"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "title": {
                "label": "Job Title",
                "format": "text"
              },
              "company": {
                "label": "Company",
                "format": "text"
              },
              "location": {
                "label": "Location",
                "format": "text"
              },
              "workType": {
                "label": "Work Type",
                "format": "text"
              },
              "jobUrl": {
                "label": "Job URL",
                "format": "link"
              }
            }
          }
        }
      }
    }
  }
}
