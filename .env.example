# Environment Variables Example
# Copy this file to .env for local development

# Apify API Token (required for local runs)
# Get your token from https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Local storage directory (optional)
# Default: ./apify_storage
APIFY_LOCAL_STORAGE_DIR=./apify_storage

# Log level (optional)
# Options: ERROR, WARNING, INFO, DEBUG
APIFY_LOG_LEVEL=INFO

# Proxy URL (optional - for testing proxy locally)
# APIFY_PROXY_URL=http://your-proxy-url

# Headless mode (optional)
# APIFY_HEADLESS=1

# Default dataset ID (optional)
# APIFY_DEFAULT_DATASET_ID=

# Default key-value store ID (optional)
# APIFY_DEFAULT_KEY_VALUE_STORE_ID=
